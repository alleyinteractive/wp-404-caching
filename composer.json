{
    "name": "alleyinteractive/wp-404-caching",
    "description": "Full Page Cache for WordPress 404s",
    "license": "GPL-2.0-or-later",
    "type": "wordpress-plugin",
    "keywords": [
        "alleyinteractive",
        "wp-404-caching"
    ],
    "authors": [
        {
            "name": "Alley",
            "email": "info@alley.com"
        }
    ],
    "homepage": "https://github.com/alleyinteractive/wp-404-caching",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "alleyinteractive/alley-coding-standards": "^2.0",
        "mantle-framework/testkit": "^1.0",
        "szepeviktor/phpstan-wordpress": "^1.1"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Alley\\WP\\WP_404_Caching\\Tests\\": "tests"
        }
    },
    "config": {
        "allow-plugins": {
            "alleyinteractive/composer-wordpress-autoloader": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "wordpress-autoloader": {
            "autoload": {
                "Alley\\WP\\WP_404_Caching\\": "src"
            },
            "autoload-dev": {
                "Alley\\WP\\WP_404_Caching\\Tests\\": "tests"
            }
        }
    },
    "scripts": {
        "phpcbf": "phpcbf .",
        "phpcs": "phpcs .",
        "phpstan": "phpstan --memory-limit=512M",
        "phpunit": "phpunit",
        "release": "npx @alleyinteractive/create-release@latest",
        "test": [
            "@phpcs",
            "@phpstan",
            "@phpunit"
        ]
    }
}
